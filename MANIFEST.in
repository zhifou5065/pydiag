include README.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include THIRD_PARTY_NOTICES.md
include pyproject.toml
include setup.py

# 第三方驱动二进制（随包分发，见 THIRD_PARTY_NOTICES.md）
recursive-include src/pydiag/vendor *.dll *.so *.dylib *.rules *.md
recursive-include src/pydiag/zlg_runtime *.dll *.xml *.ini *.md

# 排除运行时产物与缓存
prune .pydiag_config
prune .venv
prune dist
prune build
global-exclude *.py[cod] *.log *.jsonl
